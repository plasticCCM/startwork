# Copy to .env. Use a ChatAnywhere key, not a direct DeepSeek key.
DEEPSEEK_API_KEY=
# Full endpoint. The app sends requests here as-is, without appending paths.
DEEPSEEK_URL=https://api.chatanywhere.org/v1/chat/completions
DEEPSEEK_MODEL=deepseek-v4.1-flash

# Empty = local SQLite in data/startwork.db (no extra database install).
# PostgreSQL: start docker compose, then uncomment this URL in .env:
# DATABASE_URL=postgresql+psycopg://startwork:startwork_local@localhost:5438/startwork
DATABASE_URL=

# true when serving through HTTPS. false for http://127.0.0.1:8000.
COOKIE_SECURE=false
